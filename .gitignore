# Fitted models, embedding caches, ANN indexes
artifacts/
*.npz

# Data — raw catalog + anything processed (kept out of the repo).
# Ignore the directory's contents (not the dir itself) so the curated,
# version-controlled judged-query ground truth can be force-committed below.
data/*
# ...except the hand-labeled judged-query ground truth, which the free-text
# eval lens depends on.
!data/judged_queries.json

# Secrets / environment
.env
.env.*

# Claude Code — local config, not shared via the repo
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# MkDocs build output (docs/ is the source; the site is regenerated by CI — ADR-0015)
site/

# Notebooks — the .py percent scripts are the versioned source (ADR-0014); the
# .ipynb under notebooks/ are generated by jupytext on demand and executed by nbmake,
# never committed. (Pre-executed .ipynb under docs/notebooks/ ARE committed as the
# published-site render artifact — see ADR-0015 — so this rule is scoped to notebooks/.)
notebooks/*.ipynb
notebooks/.ipynb_checkpoints/

# OS / editor
.DS_Store
.ipynb_checkpoints/
